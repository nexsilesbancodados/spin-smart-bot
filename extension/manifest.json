{
  "manifest_version": 3,
  "name": "Roleta Vision AI — Captura de giros",
  "version": "6.0.0",
  "description": "Captura números da roleta brasileira (Playtech) e alimenta o app Roleta Vision AI. Apenas ingestão de dados — sem previsões, sem apostas automáticas.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://onabet.com/*",
    "*://*.onabet.com/*",
    "*://*.ona.bet.br/*",
    "*://*.betano.com/*",
    "*://*.bet365.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://onabet.com/*",
        "*://*.onabet.com/*",
        "*://*.ona.bet.br/*",
        "*://*.betano.com/*",
        "*://*.bet365.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
